<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/edittext_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/reg_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Event banner"
        android:scaleType="centerCrop"
        android:src="@drawable/navratri_event" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reg_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CULTURAL FEST"
            android:textColor="@color/green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Event Title"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reg_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Date &amp; Location"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/reg_btn_qr"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/green"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="View QR"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="12sp" />

</LinearLayout>