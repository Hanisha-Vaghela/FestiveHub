<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".SignUp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green"
        android:text="Welcome to the FestiveHub"
        android:textSize="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_gravity="center"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green"
        android:text="Join FestiveHub and celebrate every moment!"
        android:textSize="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_gravity="center"
        />

    <EditText
        android:layout_marginTop="@dimen/_30sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:textColorHint="#A8A5A5"
        android:hint="Hanisha Vaghela"
        android:paddingHorizontal="@dimen/_20sdp"
        android:background="@drawable/edittext_bg"
        android:layout_marginHorizontal="@dimen/_20sdp"

        />
    <EditText
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:textColorHint="#A8A5A5"
        android:hint="hanisha65@gmail.com"
        android:paddingHorizontal="@dimen/_20sdp"
        android:background="@drawable/edittext_bg"
        android:layout_marginHorizontal="@dimen/_20sdp"

        />
    <EditText
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:textColorHint="#A8A5A5"
        android:hint="+91 7041165889"
        android:paddingHorizontal="@dimen/_20sdp"
        android:background="@drawable/edittext_bg"
        android:layout_marginHorizontal="@dimen/_20sdp"

        />
    <EditText
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:textColorHint="#A8A5A5"
        android:hint="password"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/_20sdp"
        android:background="@drawable/edittext_bg"
        android:layout_marginHorizontal="@dimen/_20sdp"

        />
    <EditText
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:textColorHint="#A8A5A5"
        android:hint="confirm password"
        android:paddingHorizontal="@dimen/_20sdp"
        android:background="@drawable/edittext_bg"
        android:layout_marginHorizontal="@dimen/_20sdp"
        />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="SignUp"
        app:backgroundTint="@null"
        android:background="@drawable/button_bg"

        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? "
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/signup_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textColor="@color/green"
            android:textStyle="bold" />
    </LinearLayout>


</LinearLayout>