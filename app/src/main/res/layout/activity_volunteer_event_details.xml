<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VolunteerEventDetails">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FestiveHub"
                android:textColor="@color/green"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/volunteer_event_details_Banner"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Event banner"
                android:scaleType="centerCrop"
                tools:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/volunteer_event_details_Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="CULTURAL FEST"
                android:textColor="@color/green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/volunteer_event_details_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Event title"
                android:textColor="@color/black"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Date &amp; Location"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F1F3E7"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/volunteer_event_details_DateLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Oct 15, 2026 • SG Highway, Ahmedabad"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="About the Event"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/volunteer_event_details_Description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="Event description"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Schedule"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/volunteer_event_details_ScheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F8F9F4"
                android:orientation="vertical"
                android:padding="15dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F8F9F4"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/volunteer_event_details_NoSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="No schedule added for this event yet."
                    android:textColor="#777777"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/volunteer_event_details_btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="@color/green"
                android:text="Scan Attendee QR"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/volunteer_event_details_btnAttendance"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E8F5E9"
                android:text="Attendance Records"
                android:textAllCaps="false"
                android:textColor="@color/green"
                android:textSize="16sp" />

            <Button
                android:id="@+id/volunteer_event_details_btnBack"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#F1F3E7"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/green"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>