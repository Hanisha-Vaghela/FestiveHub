<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FestiveHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.FestiveHub" parent="Base.Theme.FestiveHub" />

    <!-- Splash only: green from the first moment, with light status bar icons -->
    <style name="Theme.FestiveHub.Splash" parent="Theme.FestiveHub">
        <item name="android:windowBackground">@color/green</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Login and Sign Up: always light, with green focus color -->
    <style name="Theme.FestiveHub.Auth" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
